# Number of rows for the pyramid
rows = 5

# Loop through each row
for i in range(rows):
    # Print spaces for alignment
    for j in range(rows - i - 1):
        print(" ", end="")
    
    # Print asterisks
    for k in range(2 * i + 1):
        print("*", end="")
    
    # Move to the next line after each row
    print()
